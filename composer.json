{
    "name": "bitprogmbh/sweego-laravel",
    "description": "Sweego mail transport for Laravel, using the Laravel HTTP client.",
    "keywords": ["laravel", "mail", "mailer", "sweego", "transport"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/mailer": "^7.0|^8.0",
        "symfony/mime": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bitprogmbh\\SweegoLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitprogmbh\\SweegoLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bitprogmbh\\SweegoLaravel\\SweegoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
